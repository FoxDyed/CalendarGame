{
  "name": "calendar-game",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npm run test:unit",
    "serve": "python -m http.server 4173",
    "test:unit": "node --test tests/core.test.mjs",
    "check:playwright": "node scripts/check-playwright.mjs",
    "test:e2e": "node tests/smoke-playwright.mjs",
    "test:e2e:gameplay": "node tests/gameplay-playwright.mjs",
    "test:regression": "npm run test:e2e && npm run test:e2e:gameplay",
    "ci:validate": "npm run build && npm test && npm run test:regression"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "typescript": "^5.6.3"
  }
}
